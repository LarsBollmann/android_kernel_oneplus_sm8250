# Kali NetHunter additions on top of kona-perf_defconfig + oplus.config.
# Ported from flypatriot/neutrino_kernel_oneplus_sm8250 (nethunter_defconfig).

# Chroot / Metasploit (postgres needs SysV IPC)
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_IPC_NS=y
CONFIG_MODULE_FORCE_UNLOAD=y

# Wireless stack for external USB adapters (monitor mode + injection)
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_LEDS=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_MINSTREL_HT=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT="minstrel_ht"

# USB WiFi adapters
CONFIG_ATH_COMMON=y
CONFIG_ATH9K_HTC=y
CONFIG_ATH9K_BTCOEX_SUPPORT=y
CONFIG_ATH6KL=y
CONFIG_ATH6KL_USB=y
CONFIG_CARL9170=y
CONFIG_CARL9170_LEDS=y
CONFIG_CARL9170_WPC=y
CONFIG_MT7601U=y
CONFIG_RT2X00=y
CONFIG_RT2500USB=y
CONFIG_RT73USB=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RTL_CARDS=y
CONFIG_RTL8187=y
CONFIG_RTL8187_LEDS=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_88XXAU=y
CONFIG_ZD1211RW=y
CONFIG_USB_ZD1201=y
CONFIG_USB_NET_RNDIS_WLAN=y

# USB Bluetooth adapters
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_LEDS=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBCM203X=y
CONFIG_BT_HCIBPA10X=y
CONFIG_BT_HCIBFUSB=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_ATH3K=y
CONFIG_BT_MRVL=y

# SDR (HackRF, Airspy). RTL-SDR sticks work from userspace via libusb.
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_USB_HACKRF=y
CONFIG_USB_AIRSPY=y
CONFIG_USB_MSI2500=y
CONFIG_MEDIA_TUNER_MSI001=y

# USB gadget functions (RNDIS/ECM tethering, serial, printer)
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_F_PRINTER=y

# USB host extras
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_WDM=y
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VHCI_HCD=y
CONFIG_USBIP_HOST=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y

# Filesystems for external drives
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_MSDOS_FS=y

# Netfilter extras
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_NETFILTER_XT_TARGET_HL=y

# --- Remaining options from the Kali NetHunter kernel configuration docs ---
# https://www.kali.org/docs/nethunter/nethunter-kernel-2-config-1/ (and following pages)
CONFIG_DEFAULT_HOSTNAME="kali"

# Bluetooth UART
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y

# More USB WiFi drivers
CONFIG_RTL8192CU=y
CONFIG_RTW88=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8822CU=y
CONFIG_RTW88_8723DU=y
CONFIG_RTW88_8821CU=y

# SDR: DVB-T frontends for RTL-SDR sticks
CONFIG_MEDIA_SUBDRV_AUTOSELECT=n
CONFIG_DVB_RTL2830=y
CONFIG_DVB_RTL2832=y
CONFIG_DVB_RTL2832_SDR=y
CONFIG_DVB_SI2168=y
CONFIG_DVB_ZD1301_DEMOD=y

# NFS client and server
CONFIG_NFS_FS=y
CONFIG_NFS_V2=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_NFSD=y
CONFIG_NFSD_V3=y
CONFIG_NFSD_V4=y

# CAN bus
CONFIG_NET_DEVLINK=y
CONFIG_CAN_VCAN=y
CONFIG_CAN_SLCAN=y
CONFIG_CAN_HI311X=y
CONFIG_CAN_MCP251X=y
CONFIG_CAN_EMS_USB=y
CONFIG_CAN_ESD_USB2=y
CONFIG_CAN_GS_USB=y
CONFIG_CAN_KVASER_USB=y
CONFIG_CAN_PEAK_USB=y
CONFIG_CAN_8DEV_USB=y
CONFIG_VSOCKETS=y
CONFIG_NETLINK_DIAG=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_CANID=y
CONFIG_USB_SERIAL_CONSOLE=y
CONFIG_USB_SERIAL_GENERIC=y
